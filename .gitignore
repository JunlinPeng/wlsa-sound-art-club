# Intermediate / temporary artifacts
.tmp/
*.log

# Word lock files
~$*

# Node (reserved for future tooling)
node_modules/

# Sound Blind Box game — downloaded audio (regenerated by scripts/fetch_sounds.py)
src/game/sounds/*.mp3

# API keys / secrets
*.key
.freesound_key

# Sound Map — Supabase credentials (service key must never be committed)
scripts/.env

# Sound Map — backup archives (contain a full DB dump + private recordings)
*.backup
backups/

# Sound Map — seed audio for the December theme (large binaries)
scripts/data/audio/
