# Supabase credentials for the Shanghai Sound Map.
# Copy this file to scripts/.env and fill in the values.
# scripts/.env is GITIGNORED — never commit it, and NEVER commit the service key.
#
# Find these at https://supabase.com/dashboard -> your project ->
#   gear (Project Settings) -> API Keys -> "Legacy API keys" tab  (URL + keys)
#   green "Connect" button -> Session pooler -> URI               (connection string)

# Project URL and keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Direct DB connection (pooler) — used by apply_schema.sh / make_admin.sh
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
